{
  "name": "privora",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "lint": "npm run desktop:lint && npm run marketing:lint",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:debug": "npm --prefix apps/desktop run dev:debug",
    "desktop:debug:break": "npm --prefix apps/desktop run dev:debug:break",
    "desktop:log": "npm --prefix apps/desktop run dev:log",
    "desktop:lint": "npm --prefix apps/desktop run lint",
    "desktop:test": "npm --prefix apps/desktop run test",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:release:win:x64": "npm --prefix apps/desktop run release:win:x64 --",
    "test": "npm run desktop:test",
    "build": "npm run desktop:build && npm run marketing:build",
    "marketing:dev": "npm --prefix apps/marketing run dev",
    "marketing:lint": "npm --prefix apps/marketing run lint",
    "marketing:build": "npm --prefix apps/marketing run build",
    "marketing:preview": "npm --prefix apps/marketing run preview"
