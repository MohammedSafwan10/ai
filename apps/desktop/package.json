{
  "name": "@privora/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Privora Desktop agent for local workspaces.",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "dev:debug": "electron-forge start --inspect-electron",
    "dev:debug:break": "electron-forge start --inspect-brk-electron",
    "dev:log": "electron-forge start --enable-logging",
    "dev:trace": "set PRIVORA_DEBUG=1&& electron-forge start --enable-logging",
    "start": "electron-forge start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@tanstack/react-virtual": "^3.13.26",
    "@vscode/ripgrep": "^1.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "strip-ansi": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@electron/rebuild": "^4.0.4",
    "tar": "^7.5.15",
    "tmp": "^0.2.7"
  }
}
