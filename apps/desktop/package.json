{
  "name": "@privora/desktop",
  "private": true,
  "version": "0.1.37",
  "description": "Privora Desktop agent for local workspaces.",
  "author": "Privora",
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "set PRIVORA_SKIP_PTY_REBUILD=1&& electron-forge start",
    "dev:pty": "electron-forge start",
    "dev:debug": "electron-forge start --inspect-electron",
    "dev:debug:break": "electron-forge start --inspect-brk-electron",
    "dev:log": "electron-forge start --enable-logging",
    "dev:trace": "set PRIVORA_DEBUG=1&& electron-forge start --enable-logging",
    "start": "electron-forge start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "verify": "npm run lint && npm test && npm run audit:prod",
    "prepare:package": "node scripts/prepare-package-resources.js",
    "build": "npm run prepare:package && electron-forge package",
    "make": "npm run prepare:package && electron-forge make",
    "make:mac": "npm run make -- --platform=darwin --arch=arm64",
    "make:mac:x64": "npm run make -- --platform=darwin --arch=x64",
    "make:win:x64": "npm run make -- --platform=win32 --arch=x64",
    "release:win:x64": "node scripts/release-win-x64.cjs",
    "saas:setup:credits": "node ../../appwrite/scripts/setup-credit-engine.cjs",
    "saas:admin:credits": "node ../../appwrite/scripts/admin-credit-engine.cjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.18.0",
    "@google/genai": "^2.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.26",
    "@vscode/ripgrep": "^1.18.0",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.53.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "strip-ansi": "^6.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "patch-package": "^8.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "@electron/rebuild": "^4.0.4",
    "protobufjs": "^7.6.4",
    "tar": "^7.5.16",
    "tmp": "^0.2.7",
    "undici": "^7.28.0"
  }
}
